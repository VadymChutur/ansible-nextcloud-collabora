# Керується Ansible — ручні зміни буде перезаписано
name: nextcloud

x-nextcloud: &nextcloud
  image: {{ nextcloud_image }}
  restart: unless-stopped
  env_file: .env
  volumes:
    - nextcloud_data:/var/www/html
  networks:
    - frontend
    - backend
  # Контейнери не резолвлять *.ts.net, тому домен веде на хост, де слухає Nginx
  extra_hosts:
    - "{{ tailscale_domain }}:host-gateway"
  environment:
    POSTGRES_HOST: db
    POSTGRES_DB: nextcloud
    POSTGRES_USER: nextcloud
    REDIS_HOST: redis
    REDIS_HOST_PASSWORD: ${REDIS_PASSWORD}
    PHP_MEMORY_LIMIT: 1024M
    PHP_UPLOAD_LIMIT: 10G
    APACHE_BODY_LIMIT: "0"            # за замовчуванням Apache обмежує тіло запиту 1 ГБ
    TRUSTED_PROXIES: {{ docker_subnet }} 172.17.0.0/16 127.0.0.1  
    OVERWRITEPROTOCOL: https
    OVERWRITEHOST: {{ tailscale_domain }}
    OVERWRITECLIURL: https://{{ tailscale_domain }}

networks:
  frontend:
    ipam:
      config:
        - subnet: {{ docker_frontend_subnet }}
  backend:
    internal: true                    # БД і Redis без доступу в інтернет
    ipam:
      config:
        - subnet: {{ docker_backend_subnet }}

services:
  db:
    image: {{ postgres_image }}
    restart: unless-stopped
    networks: [backend]
    shm_size: 1gb
    volumes:
      - db_data:/var/lib/postgresql/data
    environment:
      POSTGRES_DB: nextcloud
      POSTGRES_USER: nextcloud
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    command: >-
      postgres
      -c shared_buffers=1GB
      -c effective_cache_size=3GB
      -c work_mem=16MB
      -c maintenance_work_mem=256MB
      -c max_connections=200
      -c random_page_cost=1.1
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U nextcloud -d nextcloud"]
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: {{ redis_image }}
    restart: unless-stopped
    networks: [backend]
    command: ["redis-server", "--requirepass", "${REDIS_PASSWORD}"]
    environment:
      REDISCLI_AUTH: ${REDIS_PASSWORD}
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  app:
    <<: *nextcloud
    ports:
      - "127.0.0.1:8080:80"           # лише для Nginx на хості
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy

  cron:
    <<: *nextcloud
    entrypoint: /cron.sh              # фонові задачі Nextcloud кожні 5 хв
    depends_on:
      - app

  collabora:
    image: {{ collabora_image }}
    restart: unless-stopped
    networks: [frontend]
    ports:
      - "127.0.0.1:9980:9980"
    cap_add:
      - MKNOD
    extra_hosts:
      - "{{ tailscale_domain }}:host-gateway"
    environment:
      aliasgroup1: "https://{{ tailscale_domain }}:443"
      DONT_GEN_SSL_CERT: "true"
      dictionaries: "{{ collabora_dictionaries }}"
      extra_params: "--o:ssl.enable=false --o:ssl.termination=true --o:memproportion=80 --o:mount_jail_tree=false"
    volumes:
      - {{ nc_dir }}/fonts:/opt/collaboraoffice/share/fonts/truetype/custom:ro
    deploy:
      resources:
        limits:
          memory: {{ collabora_memory_limit }}

  web:
    image: {{ nginx_image }}
    restart: unless-stopped
    network_mode: host
    volumes:
      - {{ nc_dir }}/nginx.conf:/etc/nginx/nginx.conf:ro
      - {{ nc_dir }}/certs:/etc/nginx/certs:ro
    depends_on:
      - app
      - collabora

volumes:
  db_data:
  nextcloud_data:
